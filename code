<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Project Ragz v1.0.0</title>
    <style>
        * {
            box-sizing: border-box;
            user-select: none;
            -webkit-user-select: none;
        }
        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: #050505;
            font-family: 'Courier New', Courier, monospace;
            color: #00ff00;
        }
        canvas {
            display: block;
            width: 100vw;
            height: 100vh;
            background: radial-gradient(circle, #15151c 0%, #07070a 100%);
        }
        /* UI Elements */
        .overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(0, 0, 0, 0.9);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 1000;
            padding: 20px;
        }
        .window-box {
            background: #0d0d0d;
            border: 2px solid #00ffaa;
            padding: 25px;
            width: 90%;
            max-width: 550px;
            text-align: center;
            box-shadow: 0 0 20px rgba(0, 255, 170, 0.2);
            max-height: 90vh;
            overflow-y: auto;
        }
        .window-box h2, .window-box h3 {
            color: #ff0055;
            letter-spacing: 2px;
            margin-top: 0;
        }
        .btn {
            background: #00ffaa;
            color: #000;
            border: none;
            padding: 12px 24px;
            font-family: monospace;
            font-weight: bold;
            cursor: pointer;
            margin: 10px 5px;
            text-transform: uppercase;
            transition: all 0.2s;
        }
        .btn:hover {
            background: #fff;
            box-shadow: 0 0 10px #00ffaa;
        }
        .btn-danger {
            background: #ff0055;
            color: #fff;
        }
        .btn-danger:hover {
            background: #fff;
            color: #ff0055;
            box-shadow: 0 0 10px #ff0055;
        }
        .input-field {
            width: 90%;
            padding: 10px;
            background: #1a1a1a;
            border: 1px solid #00ffaa;
            color: #fff;
            font-family: monospace;
            margin-bottom: 15px;
            text-align: center;
        }
        .quiz-option {
            background: #151515;
            border: 1px solid #333;
            padding: 12px;
            margin: 8px 0;
            text-align: left;
            cursor: pointer;
            font-size: 14px;
            transition: background 0.2s;
        }
        .quiz-option:hover {
            background: #252525;
            border-color: #00ffaa;
        }
        /* Game HUD */
        #hud {
            position: fixed;
            top: 15px;
            left: 15px;
            z-index: 100;
            pointer-events: none;
            font-size: 14px;
            text-shadow: 2px 2px #000;
            line-height: 1.5;
        }
        #hud span {
            pointer-events: auto;
        }
        #spawnMenu {
            position: fixed;
            bottom: 15px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(10, 10, 10, 0.85);
            border: 1px solid #00ffaa;
            padding: 10px;
            display: flex;
            gap: 10px;
            z-index: 100;
        }
        /* Toast Notification */
        #toast {
            position: fixed;
            bottom: 90px;
            left: 50%;
            transform: translateX(-50%) translateY(150%);
            background: #ff0055;
            color: #fff;
            padding: 10px 20px;
            font-weight: bold;
            font-family: monospace;
            transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            z-index: 2000;
            border: 1px solid #fff;
        }
        #toast.show {
            transform: translateX(-50%) translateY(0);
        }
    </style>
</head>
<body>

    <div id="hud">
        <div id="versionStamp">Project Ragz v1.0.0 <span id="tosLink" style="color:#00ffaa; cursor:pointer; text-decoration:underline;">[Terms of Service]</span></div>
        <div id="walletLabel">BloodyCoins: 0</div>
        <div id="modeLabel">Gore Mode: Standard</div>
        <div id="fpsLabel">FPS: 60</div>
    </div>

    <div id="spawnMenu">
        <button class="btn" onclick="spawnNPC('civilian')">Spawn Civilian</button>
        <button class="btn" onclick="spawnNPC('swat')">Spawn SWAT</button>
        <button class="btn" onclick="triggerDisasterRandom()">Disaster</button>
        <button class="btn btn-danger" onclick="clearSandbox()">Reset</button>
    </div>

    <div id="toast">💥 BOOM</div>

    <canvas id="gameCanvas"></canvas>

    <!-- Phase 1: Account Login Screen -->
    <div id="loginScreen" class="overlay">
        <div class="window-box">
            <h2>📂 CLOUD CLONE PROFILE 📂</h2>
            <p style="font-size:11px; color:#aaa; margin-bottom:20px;">No passwords needed, bucko. Enter your email to back up your BloodyCoins and shop items forever.</p>
            <input type="email" id="accEmail" class="input-field" placeholder="example123@example.com" value="">
            <input type="text" id="accName" class="input-field" placeholder="Your Gamertag...">
            <input type="number" id="accAge" class="input-field" placeholder="Your Age">
            <br>
            <button class="btn" onclick="submitProfile()">CREATE PROFILE & SYNC</button>
        </div>
    </div>

    <!-- Phase 2: Psychological Verification Gate -->
    <div id="quizScreen" class="overlay" style="display:none;">
        <div class="window-box">
            <h2>🧠 PSYCHOLOGICAL ASSESSMENT 🧠</h2>
            <p id="quizProgress" style="font-size:12px; color:#00ffaa;">Question 1 of 5</p>
            <div id="quizQuestionBox" style="background:#151515; border:1px dashed #ff0055; padding:15px; text-align:left; margin:15px 0; font-weight:bold; color:#fff;">
                Loading challenge...
            </div>
            <div id="quizOptionsBox"></div>
            <br>
            <button class="btn btn-danger" style="width:100%; font-size:11px;" onclick="forceKidMode()">PLAY SAFE CONFETTI MODE</button>
        </div>
    </div>

    <!-- Interactive Instruments Screen (PANTERAA Cheat) -->
    <div id="instrumentScreen" class="overlay" style="display:none;">
        <div class="window-box" style="border-color:#ff0055;">
            <h3>🎸 PANTERAA DEV JAM JAM 🥁</h3>
            <p style="font-size:10px; color:#aaa;">Tap strings or keys to play sounds live!</p>
            <div style="margin: 15px 0; background:#222; padding:10px; border:1px solid #444;">
                <div style="height:5px; background:#aaa; margin:10px; cursor:pointer;" onclick="playTone(82.41, 'sawtooth')"></div>
                <div style="height:4px; background:#aaa; margin:10px; cursor:pointer;" onclick="playTone(110.00, 'sawtooth')"></div>
                <div style="height:3px; background:#aaa; margin:10px; cursor:pointer;" onclick="playTone(146.83, 'sawtooth')"></div>
                <div style="height:3px; background:#aaa; margin:10px; cursor:pointer;" onclick="playTone(196.00, 'sawtooth')"></div>
                <div style="height:2px; background:#aaa; margin:10px; cursor:pointer;" onclick="playTone(246.94, 'sawtooth')"></div>
                <div style="height:1px; background:#aaa; margin:10px; cursor:pointer;" onclick="playTone(329.63, 'sawtooth')"></div>
            </div>
            <div style="display:flex; justify-content:space-around; margin:15px 0;">
                <button class="btn" style="border-radius:50%; width:65px; height:65px; padding:0;" onclick="playTone(100, 'triangle', 0.2)">BASS</button>
                <button class="btn" style="border-radius:50%; width:55px; height:55px; padding:0;" onclick="playTone(250, 'square', 0.1)">SNARE</button>
                <button class="btn" style="border-radius:50%; width:50px; height:50px; padding:0;" onclick="playTone(800, 'sine', 0.05)">CYM</button>
            </div>
            <button class="btn btn-danger" onclick="document.getElementById('instrumentScreen').style.display='none'">Close Jam</button>
        </div>
    </div>

    <!-- Terms of Service Window -->
    <div id="tosScreen" class="overlay" style="display:none;">
        <div class="window-box" style="border-color:#ff0055; text-align:left; max-width:600px;">
            <h3 style="text-align:center;">🚨 CRITICAL DEVELOPER INSTRUCTION V1.0.0 🚨</h3>
            <p style="font-size:11px; text-align:center; color:#ff0055; font-weight:bold;">READ THE FULL THING OR A TURTLE IS GONNA BREAK INTO YOUR HOUSE AT 3 AM AND TICKLE YOUR TOES...</p>
            <hr style="border-color:#ff0055;">
            <div style="font-size:13px; line-height:1.5; color:#fff; height:250px; overflow-y:auto; padding-right:10px; background:#050505; padding:10px; border:1px solid #333;">
